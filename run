#!/usr/bin/env bash
set -Eeuo pipefail
cd "$(dirname "$(realpath "$0")")"

JAR_URL="https://raw.githubusercontent.com/TimeAndTimeStudio/TEST/main/server-release.jar"
MAP_URL="https://raw.githubusercontent.com/TimeAndTimeStudio/TEST/main/1000.msav"
SAVE_NAME="main"
MAP_NAME="1000"

mkdir -p config/maps config/saves
for cmd in java curl; do
    command -v "$cmd" >/dev/null || { echo "Missing: $cmd"; exit 1; }
done

download() {
    local url="$1" file="$2"
    if [[ -s "$file" ]]; then echo "Found: $file"; return; fi
    curl -fL --retry 3 -o "$file.part" "$url"
    test -s "$file.part"
    mv "$file.part" "$file"
}

download "$JAR_URL" server-release.jar
download "$MAP_URL" "config/maps/1000.msav"

if [[ -s "config/saves/${SAVE_NAME}.msav" ]]; then
    START_CMD="load ${SAVE_NAME}"
else
    START_CMD="host ${MAP_NAME} survival"
fi

echo "Starting Mindustry: $START_CMD"
echo "Note: Stock Mindustry has no built-in join password command."
echo "Use whitelist for access control; password 25022555 is NOT applied."

{
    sleep 4
    echo "playerlimit 3"
    echo "config autoPause true"
    echo "config autosave false"
    if [[ "$START_CMD" == host* ]]; then
        echo "reloadmaps"
        sleep 1
        echo "maps custom"
    fi
    echo "$START_CMD"
    sleep 2
    echo "status"
    if [[ -r /dev/tty ]]; then cat /dev/tty; else cat; fi
} | java --enable-native-access=ALL-UNNAMED \
    -Xms512m -Xmx5G -jar server-release.jar
